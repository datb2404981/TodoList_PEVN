    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ts-node": "10.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "nodemon": "^3.1.14",
    "prisma": "^6.4.1",
    "typescript": "5.7.3"
  }
}
